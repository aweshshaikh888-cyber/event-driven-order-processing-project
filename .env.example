# Node Environment
NODE_ENV=development

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=order-processing-system

# OpenTelemetry & Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=order-processing-system
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Database Configurations (Isolated DB per microservice)
ORDER_DB_URL=postgres://postgres:postgres@localhost:5432/order_db
PAYMENT_DB_URL=postgres://postgres:postgres@localhost:5432/payment_db
INVENTORY_DB_URL=postgres://postgres:postgres@localhost:5432/inventory_db
NOTIFICATION_DB_URL=postgres://postgres:postgres@localhost:5432/notification_db
MONOLITH_DB_URL=postgres://postgres:postgres@localhost:5432/monolith_db

# Service Ports
ORDER_SERVICE_PORT=3001
PAYMENT_SERVICE_PORT=3002
INVENTORY_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3004
MONOLITH_SERVICE_PORT=3000

# Feature Flags & Chaos Simulation
ENABLE_CHAOS_MODE=false
OUTBOX_POLL_INTERVAL_MS=1000
